{
  "name": "3d-text-generator",
  "version": "2.0.0",
  "description": "3D Text STL Studio — WebGL 3D Printable Text & Baseplate Generator",
  "main": "js/app.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "lint": "npx -y eslint js/app.js js/geometry.js worker.js",
    "check": "npm run lint && npm test",
    "prepare": "git config core.hooksPath hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.185.1"
  },
  "keywords": [
    "3d",
    "stl",
    "threejs",
    "dafont",
    "3d-printing"
  ],
  "author": "Alan Rosenthal",
  "license": "MIT"
}
